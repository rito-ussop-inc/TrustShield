# TrustShield Environment Variables

APP_NAME=TrustShield
APP_ENV=development
DATABASE_URL=sqlite:///./trustshield.db

# Threat Intelligence API Keys (get from respective services)
PHISHTANK_API_KEY=your_phishtank_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here
WEBRISK_API_KEY=your_webrisk_api_key_here

# ML Model Paths
MODEL_PATH=ml/artifacts/message_classifier.joblib
MODEL_VERSION=msg-tfidf-lr-v1.0.0
SCORING_VERSION=scoring-v2.0.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security Settings
MAX_UPLOAD_MB=10
REQUEST_TIMEOUT_SECONDS=5
RATE_LIMIT_PER_MINUTE=60